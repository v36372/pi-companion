{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "chrome",
      "node",
      "./node_modules/@cloudflare/vitest-plugin/types/cloudflare-test.d.ts"
    ]
  },
  "include": ["src", "test", "*.config.ts"]
}
