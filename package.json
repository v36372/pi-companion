{
  "name": "companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "local:up": "node scripts/local.mjs up",
    "local:deploy": "node scripts/local.mjs deploy",
    "local:diagnose": "node scripts/local.mjs diagnose",
    "local:down": "node scripts/local.mjs down",
    "test:celld": "node scripts/local.mjs test",
    "build:extension": "vite build",
    "watch:extension": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts src test scripts *.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt src test scripts docs *.ts package.json tsconfig.json wrangler.jsonc README.md",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:browser": "pnpm build:extension && node scripts/smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:extension && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "@oxlint/plugins": "1.88.0",
    "@types/chrome": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "packageManager": "pnpm@11.15.1"
}
