{
  "manifest_version": 3,
  "name": "Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "description": "A durable, URL-scoped personal agent with Executor MCP.",
  "permissions": ["sidePanel", "contextMenus", "storage", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Companion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-companion": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open Companion for this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
